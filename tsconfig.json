{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2021", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": false,
    "types": ["node", "vscode"]
  },
  "include": ["extension.js", "lib/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "lib/generated", "tests", "scripts"]
}
