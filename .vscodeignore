# Keep VSIX small
node_modules/**
scripts/**
# Dev inputs; themes/ is what the extension loads at runtime
theme-sources/**
package-lock.json
analysis_options.yaml
.vscode/**
.github/**
Makefile
MAINTENANCE.md
PROMOTION.md

# Landing page (deployed to GitHub Pages, not shipped in the VSIX)
docs/**

# Local theme preview samples (not shipped)
samples/**
images/screenshot-*.jpg

# Extra exclusions
.vscode-test/**
**/*.map
**/tsconfig.json
**/.eslintrc*
.gitignore
*.vsix
