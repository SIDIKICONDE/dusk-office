# Keep VSIX small — only what the runtime extension needs.
# The runtime is bundled into dist/ by esbuild (vscode:prepublish); ship that,
# not the CommonJS source.
extension.js
lib/**
node_modules/**
scripts/**
# Dev inputs; themes/ is what the extension loads at runtime
theme-sources/**
package-lock.json
analysis_options.yaml
.vscode/**
.github/**
Makefile
MAINTENANCE.md
PROMOTION.md

# Landing page (deployed to GitHub Pages, not shipped in the VSIX)
docs/**

# Local theme preview samples (not shipped)
samples/**
images/screenshot-*.jpg

# JetBrains plugin — has its own distribution channel
jetbrains-plugin/**

# Cross-IDE exports (Neovim, Emacs, Zed, Helix, JetBrains, base16) —
# not used by the VS Code runtime, only for downloads from GitHub releases
exports/**

# Tests — not needed at runtime
tests/**

# Local IDE / dev / log noise
.idea/**
.gradle/**
.intellijPlatform/**
*.log
firebase-debug.log
firebase-debug.*.log
.editorconfig
.vscodeignore

# Extra exclusions
.vscode-test/**
**/*.map
**/tsconfig.json
**/.eslintrc*
.gitignore
*.vsix
