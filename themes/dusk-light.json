  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#475569",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.line.double-slash",
      "settings": {
        "foreground": "#475569",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#166534"
      }
    },
    {
      "scope": "string.quoted.single",
      "settings": {
        "foreground": "#166534"
      }
    },
    {
      "scope": "string.quoted.double",
      "settings": {
        "foreground": "#14532d"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#5b21b6"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#9f1853"
      }
    },
    {
      "scope": "keyword.control.flow",
      "settings": {
        "foreground": "#9f1853",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#1d4ed8"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#1e40af"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "scope": "entity.name.class",
      "settings": {
        "foreground": "#b45309"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#9f1853"
      }
    },
    {
      "scope": "support.type",
      "settings": {
        "foreground": "#0f766e"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#b45309",
      "bold": true
