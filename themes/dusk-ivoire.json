  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#3d4f58",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.line.double-slash",
      "settings": {
        "foreground": "#3d4f58",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#2d6b48"
      }
    },
    {
      "scope": "string.quoted.single",
      "settings": {
        "foreground": "#2d6b48"
      }
    },
    {
      "scope": "string.quoted.double",
      "settings": {
        "foreground": "#24603e"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#5c2d8a"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#8b1748"
      }
    },
    {
      "scope": "keyword.control.flow",
      "settings": {
        "foreground": "#8b1748",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#2a5f9e"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#254680"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#1f8776"
      }
    },
    {
      "scope": "entity.name.class",
      "settings": {
        "foreground": "#92400e"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#8b1748"
      }
    },
    {
      "scope": "support.type",
      "settings": {
        "foreground": "#1f8776"
      }
    }
  ],
