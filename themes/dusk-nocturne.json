    "operator": "#a09078",
    "number": "#d4a853",
    "string": "#a8b898",
    "regexp": "#c98b7a",
    "lifetime": {
      "foreground": "#c9a87a",
      "italic": true
    },
    "label": {
      "foreground": "#c9a87a",
      "italic": true
    },
    "comment": {
      "foreground": "#7a6b5a",
      "italic": true
    },
    "*.async": {
      "italic": true
    },
    "*.static": "#a890b8",
    "*.abstract": {
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "class.defaultLibrary": "#e8c87a"
