  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a6b5a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block",
        "comment.block.css",
        "comment.block.scss",
        "comment.block.less",
        "comment.block.postcss"
      ],
      "settings": {
        "foreground": "#7a6b5a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.line.double-slash",
      "settings": {
        "foreground": "#7a6b5a",
        "fontStyle": "italic"
