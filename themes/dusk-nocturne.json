    "variable.readonly": "#a890b8",
    "variable.defaultLibrary": "#a8c0b0",
    "property": "#b8a890",
    "property.readonly": "#b8a890",
    "parameter": "#c9a87a",
    "selfParameter": {
      "foreground": "#c97565",
      "italic": true
