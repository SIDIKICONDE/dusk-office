{
  "$schema": "vscode://schemas/color-theme",
  "name": "Dusk Office",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#010203",
    "editor.foreground": "#d1e0e8",
    "activityBar.background": "#000000",
    "sideBar.background": "#010202",
    "tree.indentGuidesStroke": "#304f6066",
    "tree.inactiveIndentGuidesStroke": "#304f6033",
    "list.hoverBackground": "#304f600f",
    "list.activeSelectionBackground": "#304f601a",
    "list.inactiveSelectionBackground": "#304f6012",
    "list.focusBackground": "#304f601a",
    "statusBar.background": "#000000",
    "titleBar.activeBackground": "#010102"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#304f60",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#db2777"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#a855f7"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#b8d4e4",
    "function": "#06b6d4",
    "keyword": "#db2777"
  }
}
