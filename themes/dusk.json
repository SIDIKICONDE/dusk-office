  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b8a9c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.line.double-slash",
      "settings": {
        "foreground": "#6b8a9c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "scope": "string.quoted.single",
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "scope": "string.quoted.double",
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#a855f7"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#a855f7"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#db2777"
      }
    },
    {
      "scope": "keyword.control.flow",
      "settings": {
        "foreground": "#db2777",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#22d3ee"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#06b6d4"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#0891b2"
      }
    },
    {
      "scope": "entity.name.class",
      "settings": {
        "foreground": "#ca8a04"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#db2777"
      }
    },
    {
      "scope": "support.type",
      "settings": {
        "foreground": "#0891b2"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#b8d4e4"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#ea580c"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#db2777"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#06b6d4"
      }
    },
    {
      "scope": "constant.character",
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#a855f7"
      }
    },
    {
      "scope": "support.function",
      "settings": {
        "foreground": "#06b6d4"
      }
    },
    {
      "scope": "support.variable",
      "settings": {
        "foreground": "#b8d4e4"
      }
    },
    {
      "scope": "punctuation.definition.variable",
      "settings": {
        "foreground": "#b8d4e4"
      }
    }
