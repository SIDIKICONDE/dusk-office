  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#356a82",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.line.double-slash",
      "settings": {
        "foreground": "#356a82",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#4aac92"
      }
    },
    {
      "scope": "string.quoted.single",
      "settings": {
        "foreground": "#4aac92"
      }
    },
    {
      "scope": "string.quoted.double",
      "settings": {
        "foreground": "#4aac92"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#b794f4"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#e84878"
      }
    },
    {
      "scope": "keyword.control.flow",
      "settings": {
        "foreground": "#e84878",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#38c8e0"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#2ecce0"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#00acc8"
      }
    },
    {
      "scope": "entity.name.class",
      "settings": {
        "foreground": "#e0b040"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#e84878"
      }
    },
    {
      "scope": "support.type",
      "settings": {
        "foreground": "#00acc8"
      }
    }
  ],
