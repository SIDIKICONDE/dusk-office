  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6e7681",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block",
        "comment.block.css",
        "comment.block.scss",
        "comment.block.less",
        "comment.block.postcss"
      ],
      "settings": {
        "foreground": "#6e7681",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.line.double-slash",
