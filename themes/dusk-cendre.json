      "italic": true
    },
    "label": {
      "foreground": "#d4a574",
      "italic": true
    },
    "comment": {
      "foreground": "#6e7681",
      "italic": true
    },
    "*.async": {
      "italic": true
    },
    "*.static": "#b1bac4",
    "*.abstract": {
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "class.defaultLibrary": "#e5e7eb"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6e7681",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.line.double-slash",
      "settings": {
        "foreground": "#6e7681",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#86a88a"
      }
    },
    {
      "scope": "string.quoted.single",
      "settings": {
        "foreground": "#86a88a"
      }
    },
    {
      "scope": "string.quoted.double",
      "settings": {
        "foreground": "#86a88a"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#b1bac4"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#9ca3af"
      }
    },
    {
      "scope": "keyword.control.flow",
      "settings": {
        "foreground": "#9ca3af",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#adb5bd"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#f0f3f6"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#d1d5db"
      }
    },
    {
      "scope": "entity.name.class",
      "settings": {
        "foreground": "#d1d5db"
      }
    },
    {
      "scope": "storage.type",
