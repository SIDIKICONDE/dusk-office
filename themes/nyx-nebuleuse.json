{
  "$schema": "vscode://schemas/color-theme",
  "name": "Nyx Nébuleuse",
  "include": "./nyx.json",
  "colors": {
    "editor.background": "#1a0f2e",
    "editorCursor.background": "#1a0f2e",
    "editorGutter.background": "#180d2a",
    "editor.lineHighlightBackground": "#a855f722",
    "editor.lineHighlightBorder": "#c084fc66",
    "editorWidget.background": "#140a26",
    "editorHoverWidget.background": "#140a26",
    "editorSuggestWidget.background": "#140a26",
    "editorHoverWidget.statusBarBackground": "#100820",
    "diffEditor.diagonalFill": "#2d1a4a",
    "diffEditor.unchangedRegionBackground": "#140a26",
    "editorGroup.emptyBackground": "#140a26",
    "editorGroup.border": "#7c3aed",
    "editorGroupHeader.tabsBackground": "#0c0618",
    "editorGroupHeader.tabsBorder": "#7c3aed",
    "editorGroupHeader.noTabsBackground": "#0c0618",
    "tab.activeBackground": "#1a0f2e",
    "tab.inactiveBackground": "#0c0618",
    "tab.hoverBackground": "#1a0f2eaa",
    "tab.unfocusedActiveBackground": "#1a0f2e",
    "tab.border": "#5b21b6",
    "breadcrumb.background": "#140a26",
    "activityBar.background": "#080410",
    "activityBar.foreground": "#e9d5ff",
    "activityBar.activeBorder": "#c084fc",
    "activityBar.inactiveForeground": "#5b4a78",
    "activityBar.border": "#6d28d9",
    "sideBar.background": "#10081e",
    "sideBar.border": "#6d28d9",
    "sideBarTitle.foreground": "#d8b4fe",
    "sideBarSectionHeader.background": "#080410",
    "sideBarSectionHeader.foreground": "#e9d5ff",
    "sideBarSectionHeader.border": "#6d28d9",
    "panel.background": "#0c0618",
    "panel.border": "#6d28d9",
    "panelInput.border": "#6d28d9",
    "panelTitle.activeForeground": "#c084fc",
    "panelTitle.activeBorder": "#a855f7",
    "panelSectionHeader.background": "#080410",
    "panelSectionHeader.border": "#6d28d9",
    "statusBar.background": "#080410",
    "statusBar.border": "#6d28d9",
    "titleBar.activeBackground": "#0c0618",
    "titleBar.inactiveBackground": "#080410",
    "titleBar.border": "#6d28d9",
    "menu.background": "#140a26",
    "menu.border": "#6d28d9",
    "quickInput.background": "#140a26",
    "quickInputTitle.background": "#0c0618",
    "commandCenter.background": "#140a26",
    "commandCenter.border": "#8b5cf6",
    "input.background": "#140a26",
    "input.border": "#7c3aed",
    "dropdown.background": "#140a26",
    "dropdown.border": "#7c3aed",
    "dropdown.listBackground": "#140a26",
    "checkbox.background": "#140a26",
    "checkbox.border": "#7c3aed",
    "minimap.background": "#0c0618",
    "terminal.background": "#06030e",
    "peekViewEditor.background": "#140a26",
    "peekViewResult.background": "#10081e",
    "peekViewTitle.background": "#0c0618",
    "peekView.border": "#a855f788",
    "notifications.background": "#140a26",
    "notificationCenterHeader.background": "#0c0618",
    "list.activeSelectionBackground": "#a855f728",
    "list.activeSelectionIconForeground": "#e9d5ff",
    "list.hoverBackground": "#a855f714",
    "focusBorder": "#c084fccc",
    "scrollbarSlider.background": "#a855f718",
    "scrollbarSlider.hoverBackground": "#a855f730",
    "gitDecoration.untrackedResourceForeground": "#c084fc"
  },
  "semanticTokenColors": {
    "class": {
      "foreground": "#fbbf24",
      "bold": true
    },
    "class.declaration": {
      "foreground": "#fbbf24",
      "bold": true
    },
    "interface": {
      "foreground": "#fde68a",
      "italic": true
    },
    "enum": "#fbbf24",
    "enumMember": "#d8b4fe",
    "struct": "#fbbf24",
    "type": "#c4b5fd",
    "typeAlias": {
      "foreground": "#c4b5fd",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#c4b5fd",
      "italic": true
    },
    "namespace": "#a78bfa",
    "module": "#a78bfa",
    "function": "#e9d5ff",
    "function.declaration": "#ddd6fe",
    "method": "#ddd6fe",
    "method.declaration": "#ddd6fe",
    "macro": "#d8b4fe",
    "decorator": {
      "foreground": "#fdba74",
      "italic": true
    },
    "variable": "#e4e4f7",
    "variable.readonly": "#d8b4fe",
    "variable.defaultLibrary": "#a78bfa",
    "property": "#a5b4fc",
    "property.readonly": "#a5b4fc",
    "parameter": "#fb923c",
    "selfParameter": {
      "foreground": "#f472b6",
      "italic": true
    },
    "keyword": "#f472b6",
    "operator": "#c084fc",
    "number": "#fcd34d",
    "string": "#99f6e4",
    "regexp": "#fb7185",
    "lifetime": {
      "foreground": "#fb923c",
      "italic": true
    },
    "label": {
      "foreground": "#fb923c",
      "italic": true
    },
    "comment": {
      "foreground": "#7c6a9a",
      "italic": true
    },
    "*.async": {
      "italic": true
    },
    "*.static": "#d8b4fe",
    "*.abstract": {
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "class.defaultLibrary": "#fde68a"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7c6a9a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.line.double-slash",
      "settings": {
        "foreground": "#7c6a9a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#99f6e4"
      }
    },
    {
      "scope": "string.quoted.single",
      "settings": {
        "foreground": "#99f6e4"
      }
    },
    {
      "scope": "string.quoted.double",
      "settings": {
        "foreground": "#99f6e4"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#fcd34d"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "scope": "keyword.control.flow",
      "settings": {
        "foreground": "#f472b6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#c084fc"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#e9d5ff"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#c4b5fd"
      }
    },
    {
      "scope": "entity.name.class",
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "scope": "support.type",
      "settings": {
        "foreground": "#c4b5fd"
      }
    }
  ]
}
