    {
      "scope": "string.quoted.single",
      "settings": {
        "foreground": "#c4b8a8"
      }
    },
    {
      "scope": "string.quoted.double",
      "settings": {
        "foreground": "#c9b8a4"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#c9b8a4"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#d4a574"
      }
    },
    {
      "scope": "keyword.control.flow",
      "settings": {
        "foreground": "#d4a574",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
