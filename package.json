    "sync:aaa": "node -e \"process.env.SYNC_MIN_CONTRAST='7'; import('./scripts/sync-from-workspace.mjs')\"",
    "make:full": "npm run theme:sources:sync && npm run sync:aa && npm run variants:ui && npm run variants:syntax && npm run build:hc && npm run build:ivoire-sombre && npm run fix:ui-contrast && npm run build:bundle && npm run validate",
    "make:full:install": "npm run make:full && npm run package && npm run install-vsix",
    "make:release": "npm run bump:patch && npm run make:full && npm run package:raw && node scripts/clean-old-vsix.mjs",
    "make:release:no-bump": "npm run make:full && npm run package:raw && node scripts/clean-old-vsix.mjs",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major",
    "release:patch": "npm run make:release",
    "release:minor": "npm run bump:minor && npm run make:release:no-bump",
    "release:major": "npm run bump:major && npm run make:release:no-bump",
    "release:patch:install": "npm run release:patch && npm run install-vsix",
    "release:minor:install": "npm run release:minor && npm run install-vsix",
    "release:major:install": "npm run release:major && npm run install-vsix",
    "full": "npm run make:full",
    "themes:regen": "npm run make:full",
    "theme:sources:sync": "node scripts/sync-theme-sources.mjs",
    "theme:sources:extract": "node scripts/extract-theme-sources.mjs",
    "rel": "npm run make:release",
    "rpi": "npm run release:patch:install",
    "push:auto": "npm run push:main:auto",
    "push:safe": "npm run push:main:safe",
    "push:main:auto": "node scripts/auto-push-main.mjs --yes",
    "push:main:safe": "node scripts/auto-push-main.mjs",
    "variants:ui": "node scripts/merge-extended-ui-colors.mjs && npm run build:light && npm run build:ivoire && npm run build:audit && node scripts/apply-light-terminal-ansi.mjs",
    "soften:borders": "node scripts/soften-chrome-borders.mjs",
    "boost:borders": "node scripts/boost-border-contrast.mjs",
    "dim:borders": "node scripts/dim-border-luminosity.mjs",
    "variants:syntax": "node scripts/merge-syntax-into-variants.mjs",
    "validate": "node scripts/verify-runtime-constants.mjs && node scripts/validate-themes.mjs && node scripts/verify-theme-pipeline.mjs && node scripts/verify-terminal-contrast.mjs && node scripts/verify-ui-contrast.mjs && node scripts/audit-contrast.mjs && node scripts/check-theme-distinctiveness.mjs --strict && npm run validate:pydantic",
    "distinctiveness:check": "node scripts/check-theme-distinctiveness.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "verify:themes-fresh": "node scripts/verify-themes-fresh.mjs",
    "verify:constants": "node scripts/verify-runtime-constants.mjs",
    "verify:terminal": "node scripts/verify-terminal-contrast.mjs",
    "verify:ui": "node scripts/verify-ui-contrast.mjs",
    "audit:ui-contrast": "node scripts/verify-ui-contrast.mjs",
    "fix:ui-contrast": "node scripts/fix-ui-contrast.mjs",
    "build:bundle": "node scripts/build-themes-bundle.mjs",
    "build:ext": "node scripts/build-extension.mjs",
    "watch:ext": "node scripts/build-extension.mjs --watch",
    "vscode:prepublish": "npm run build:bundle && npm run build:ext",
    "adaptive:focus": "node scripts/adaptive-focus-mode.mjs",
    "release-check": "node scripts/verify-release-version.mjs",
    "build:hc": "node scripts/build-dusk-hc.mjs",
    "build:light": "node scripts/build-dusk-light.mjs",
    "build:ivoire": "node scripts/build-dusk-ivoire.mjs",
    "build:audit": "node scripts/build-dusk-audit.mjs",
    "build:ivoire-sombre": "node scripts/build-dusk-ivoire-sombre.mjs",
