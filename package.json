    "publish:all": "npm run publish:vsce && npm run publish:ovsx",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "test": "node --require ./tests/setup.js --test tests/theme-common.test.js tests/hour-schedule.test.js tests/schedule-time.test.js tests/theme-gallery.test.js tests/terminal-contrast.test.js tests/terminal-contrast-internals.test.js tests/ansi-parser.test.js tests/workspace-fingerprint.test.js tests/jetbrains-laf-theme.test.js tests/marketplace-review-prompt.test.js tests/theme-data.test.js tests/ui-contrast.test.js tests/contrast-fix.test.js",
    "py:install": "pip install -e \".[dev]\"",
    "validate:pydantic": "python -m dusk_office.validate_schemas",
    "analyze:themes": "python -m dusk_office.analyze_themes",
    "test:py": "pytest python/tests",
    "test:unit": "npm test && npm run test:py",
    "test:web": "node scripts/test-web.mjs && node tests/test-web-activation.mjs",
    "test:web:install": "playwright install chromium",
    "test:all": "npm run test:unit && npm run build:bundle && npm run build:ext && npm run test:web",
    "tag:release": "node scripts/release-tag.mjs"
