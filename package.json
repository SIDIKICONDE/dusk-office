        "duskOffice.syntax.italicComments": {
          "type": "boolean",
          "default": true,
          "order": 40,
          "description": "Show comments in italic. Dusk Office themes use italic comments by default; turn this off for upright comments.",
          "markdownDescription": "**Italic comments**\n\nDusk Office themes render comments in *italic* by default. Disable this to display comments without italics. Applies live to the active Dusk Office theme via `editor.tokenColorCustomizations`."
        },
        "duskOffice.syntax.boldKeywords": {
