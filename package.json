    "walkthroughs": [
      {
        "id": "duskOfficeGetStarted",
        "title": "Get Started with Dusk Office",
        "description": "Set up your theme system in 2 minutes — gallery, workspace fingerprint, day/night switch, adaptive focus, Control Center.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome to Dusk Office",
            "description": "Your editor is about to feel different. Apply the flagship theme and see the Dusk Office philosophy in action.\n[Apply the default Dusk Office theme](command:workbench.action.selectTheme)",
            "media": {
              "markdown": "walkthrough/01-welcome.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.selectTheme"
            ]
          },
          {
            "id": "quickSetup",
            "title": "Quick Setup — 30 seconds to perfection",
            "description": "Pick your variant, choose your automation mode, done. One flow, zero config files.\n[Run Quick Setup](command:duskOffice.quickSetup)",
            "media": {
              "markdown": "walkthrough/02-quick-setup.md"
            },
            "completionEvents": [
              "onCommand:duskOffice.quickSetup"
            ]
          },
          {
            "id": "pickVariant",
            "title": "Explore 27 variants",
            "description": "Every variant has a purpose — from deep-focus Midnight to domain-tuned Audit, Vault, and Sentinel. Hover to preview, click to apply.\n[Open the variant picker](command:duskOffice.switchThemeVariant)\n[Open the Theme Gallery](command:duskOffice.openThemeGallery)",
            "media": {
              "markdown": "walkthrough/03-variants.md"
            },
            "completionEvents": [
              "onCommand:duskOffice.switchThemeVariant",
              "onCommand:duskOffice.openThemeGallery"
            ]
          },
          {
            "id": "fingerprint",
            "title": "Your project, your palette — automatically",
            "description": "Dusk Office reads your project’s DNA and suggests the perfect variant. Fintech → Vault, security → Sentinel, ML → Steward. 100% local, zero telemetry.\n[Try the suggestion for this workspace](command:duskOffice.suggestVariantForWorkspace)",
            "media": {
              "markdown": "walkthrough/04-fingerprint.md"
            },
            "completionEvents": [
              "onCommand:duskOffice.suggestVariantForWorkspace"
            ]
          },
          {
            "id": "adaptive",
            "title": "A theme that adapts to your rhythm",
            "description": "Auto Day/Night switches light ↔ dark by the hour. Adaptive Focus goes further — picking variants by language and time. Late-night eye comfort included.\n[Toggle Adaptive Focus](command:duskOffice.toggleAdaptiveFocus)\n[Apply Adaptive Theme Now](command:duskOffice.applyAdaptiveFocusTheme)",
            "media": {
              "markdown": "walkthrough/05-adaptive.md"
            },
            "completionEvents": [
              "onCommand:duskOffice.toggleAdaptiveFocus",
              "onCommand:duskOffice.applyAdaptiveFocusTheme"
            ]
          },
          {
            "id": "controlCenter",
            "title": "One place to control everything",
            "description": "The Control Center gives you every Dusk Office action in a single Quick Pick — themes, favorites, automation, icons, WCAG checks, and reset.\n[Open the Control Center](command:duskOffice.openControlCenter)",
            "media": {
              "markdown": "walkthrough/06-control-center.md"
            },
            "completionEvents": [
              "onCommand:duskOffice.openControlCenter"
            ]
          },
          {
            "id": "ansiEditor",
            "title": "ANSI colors — logs come alive",
            "description": "Open any .log file or source containing ANSI escape codes — Dusk Office renders them with your theme's terminal.ansi* palette, live in the editor.\n[Toggle ANSI in Editor](command:duskOffice.toggleEditorAnsi)",
            "media": {
              "markdown": "walkthrough/07-ansi-editor.md"
            },
            "completionEvents": [
              "onCommand:duskOffice.toggleEditorAnsi"
            ]
          },
          {
            "id": "makeItYours",
            "title": "Make it truly yours",
            "description": "Fine-tune every behavior in Settings. And if you ever want a clean slate — one command resets everything with zero residue.\n[Open Dusk Office settings](command:duskOffice.openSettings)",
            "media": {
              "markdown": "walkthrough/08-make-it-yours.md"
            },
            "completionEvents": [
              "onCommand:duskOffice.openSettings"
            ]
          }
        ]
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true,
      "editor.bracketPairColorization.enabled": true,
      "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
      "editor.guides.bracketPairs": "active"
    },
    "configuration": {
      "title": "Dusk Office",
      "properties": {
        "duskOffice.nythyCleanerRecommendation": {
          "type": "boolean",
          "default": true,
          "order": 0,
          "markdownDescription": "**🛠️ NythyCleaner Recommendation — [Try NythyCleaner →](https://nythycleaner.cloud)**\n\nAlso by the same developer. Your Mac, clean and fast: Xcode cleanup (22 categories), full system monitoring (CPU, GPU, Neural Engine), security audit (CVE scanning), 20+ dev ecosystem scans, disk treemap, exact SHA-256 duplicates, privacy tools.\n\nThe essentials are free. Disable this checkbox if you do not want to see NythyCleaner recommendations in Dusk Office surfaces."
        },
        "duskOffice.marketplaceReview": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "Ask for a Marketplace star rating after you've used Dusk Office for a while.",
          "markdownDescription": "**⭐ Marketplace review**\n\nAfter a few sessions and at least a week of use, Dusk Office may ask once for a quick star rating on the [VS Code Marketplace](https://marketplace.visualstudio.com/items?itemName=dekidev.dusk-office), [Open VSX](https://open-vsx.org/extension/dekidev/dusk-office), or [JetBrains Marketplace](https://plugins.jetbrains.com/plugin/31875-dusk-office-themes). Ratings help others discover these themes and improve recommendations.\n\nDisable this checkbox if you do not want review reminders."
        },
