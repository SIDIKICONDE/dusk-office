      "commandPalette": [
        {
          "command": "duskOffice.toggleAdaptiveFocus"
        },
        {
          "command": "duskOffice.applyAdaptiveFocusTheme"
        },
        {
          "command": "duskOffice.suggestVariantForWorkspace"
        }
      ],
      "editor/title": [
        {
          "command": "duskOffice.openControlCenter",
          "group": "navigation@100",
          "when": "duskOffice.isActive"
        }
      ],
      "editor/title/context": [
        {
          "command": "duskOffice.switchThemeVariant",
          "group": "duskOffice@1",
          "when": "duskOffice.isActive"
        },
        {
          "command": "duskOffice.toggleAdaptiveFocus",
          "group": "duskOffice@2",
          "when": "duskOffice.isActive"
        }
      ]
    },
    "keybindings": [
      {
        "command": "duskOffice.openControlCenter",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d",
        "when": "duskOffice.isActive"
      },
      {
        "command": "duskOffice.switchThemeVariant",
        "key": "ctrl+k ctrl+shift+t",
        "mac": "cmd+k cmd+shift+t",
        "when": "duskOffice.isActive"
      },
      {
        "command": "duskOffice.switchToPreviousTheme",
        "key": "ctrl+k ctrl+shift+p",
        "mac": "cmd+k cmd+shift+p",
        "when": "duskOffice.isActive"
      },
      {
        "command": "duskOffice.toggleAdaptiveFocus",
        "key": "ctrl+k ctrl+shift+a",
        "mac": "cmd+k cmd+shift+a",
        "when": "duskOffice.isActive"
      }
    ]
