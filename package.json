{
  "name": "dusk-office",
  "displayName": "Dusk Office — Professional Themes for Finance & Security",
  "description": "One adaptive theme system — 27 WCAG-verified variants, live gallery, workspace fingerprint & day/night auto switch. VS Code, Cursor, Windsurf & web. Finance, audit, SOC, DevOps.",
  "version": "1.5.1",
  "publisher": "dekidev",
  "icon": "images/icon.png",
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "license": "GPL-3.0-or-later",
  "homepage": "https://sidikiconde.github.io/dusk-office/",
  "repository": {
    "type": "git",
    "url": "https://github.com/SIDIKICONDE/dusk-office.git"
  },
  "galleryBanner": {
    "color": "#031c28",
    "theme": "dark"
  },
  "qna": "marketplace",
  "pricing": "Free",
  "markdown": "github",
  "bugs": {
    "url": "https://github.com/SIDIKICONDE/dusk-office/issues"
  },
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/dekidev.dusk-office?label=Marketplace",
      "href": "https://marketplace.visualstudio.com/items?itemName=dekidev.dusk-office",
      "description": "VS Code Marketplace version"
    },
    {
      "url": "https://img.shields.io/open-vsx/v/dekidev/dusk-office?label=Open%20VSX",
      "href": "https://open-vsx.org/extension/dekidev/dusk-office",
      "description": "Open VSX version"
    }
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Dusk Office only reads workspace metadata (package.json, Cargo.toml, pyproject.toml, etc.) to suggest a theme variant. No code execution, no network calls."
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:rust",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:json",
    "onLanguage:markdown",
    "onLanguage:yaml",
    "onLanguage:shellscript",
    "onLanguage:dockerfile",
    "onLanguage:sql",
    "onLanguage:plaintext",
    "onLanguage:log",
    "workspaceContains:**/package.json",
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/go.mod",
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/composer.json",
    "workspaceContains:**/Gemfile",
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/Dockerfile",
    "workspaceContains:**/.git"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "theme pack",
    "color theme",
    "vscode theme",
    "cursor theme",
    "windsurf theme",
    "high contrast theme",
    "accessible theme",
    "colorblind friendly",
    "wcag theme",
    "oled theme",
    "eye comfort",
    "professional theme",
    "finance theme",
    "fintech theme",
    "banking theme",
    "audit theme",
    "cybersecurity theme",
    "soc theme",
    "devops theme",
    "semantic highlighting",
    "adaptive theme",
    "auto dark mode",
