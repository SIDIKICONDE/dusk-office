          "type": "boolean",
          "default": true,
          "order": 45,
          "markdownDescription": "**ANSI in editor** — colorize escape sequences in logs and source (`\\x1B[31m`, `\\033[36m`, etc.) using the active theme's `terminal.ansi*` colors.\n\nDisable to turn off all in-editor ANSI highlighting."
        },
        "duskOffice.editorAnsi.allLanguages": {
          "type": "boolean",
          "default": true,
          "order": 46,
          "description": "When enabled, ANSI coloring applies in any language (Dart, TypeScript, Python, …) if the file contains sequences. When disabled, only editorAnsi.languageIds are used."
        },
        "duskOffice.editorAnsi.dimEscapeSequences": {
          "type": "boolean",
          "default": true,
          "order": 47,
          "description": "Fade raw ESC [ … m byte sequences in log/output files. Does not affect \\x1B literals in source code."
        },
        "duskOffice.editorAnsi.languageIds": {
          "type": "array",
          "default": [
            "log",
            "ansi"
          ],
          "order": 48,
          "items": {
            "type": "string"
          },
          "description": "Language IDs used for ANSI coloring when editorAnsi.allLanguages is false (e.g. log, ansi, plaintext)."
        },
        "duskOffice.editorAnsi.maxLineCount": {
          "type": "number",
          "default": 12000,
          "minimum": 0,
          "order": 49,
          "description": "Maximum lines to scan and colorize per file. Set to 0 for no limit (large logs may slow the editor)."
