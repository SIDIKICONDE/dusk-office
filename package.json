    "export:ide": "node scripts/export-ide-themes.mjs",
    "jetbrains:sync": "node scripts/sync-jetbrains-plugin.mjs",
    "jetbrains:build": "npm run export:ide && npm run jetbrains:sync && node scripts/run-gradle.mjs buildPlugin --no-daemon",
    "jetbrains:install": "node scripts/install-jetbrains-plugin.mjs",
