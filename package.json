{
  "name": "dusk-office",
  "displayName": "Dusk-Office",
  "description": "Dark themes for VS Code. Building tools that make coding more comfortable and visually elegant.",
  "version": "0.6.9",
  "publisher": "dekidev",
  "icon": "images/icon.png",
  "license": "UNLICENSED",
  "homepage": "https://marketplace.visualstudio.com/items?itemName=dekidev.dusk-office",
  "repository": {
    "type": "git",
    "url": "https://github.com/SIDIKICONDE/dusk-office.git"
  },
  "galleryBanner": {
    "color": "#031c28",
    "theme": "dark"
  },
  "qna": "marketplace",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Themes"],
  "keywords": [
    "theme",
    "dark",
    "cyan",
    "dusk-office",
    "contrast",
    "high contrast",
    "light",
    "semantic highlighting",
    "color-theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Dusk-Office",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk.json"
      },
      {
        "label": "Dusk-Office Abyss",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-abime.json"
      },
      {
        "label": "Dusk-Office Dawn",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-aube.json"
      },
      {
        "label": "Dusk-Office Bay",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-baie.json"
      },
      {
        "label": "Dusk-Office Mist",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-brume.json"
      },
      {
        "label": "Dusk-Office Ash",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-cendre.json"
      },
      {
        "label": "Dusk-Office Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-minuit.json"
      },
      {
        "label": "Dusk-Office Nebula",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-nebuleuse.json"
      },
      {
        "label": "Dusk-Office Reef",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-recif.json"
      },
      {
        "label": "Dusk-Office High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/dusk-hc.json"
      },
      {
        "label": "Dusk-Office Light",
        "uiTheme": "vs",
        "path": "./themes/dusk-light.json"
      },
      {
        "label": "Dusk-Office Ivory",
        "uiTheme": "vs",
        "path": "./themes/dusk-ivoire.json"
      },
      {
        "label": "Dusk-Office Dark Ivory",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-ivoire-sombre.json"
      },
      {
        "label": "Dusk-Office Nocturne",
        "uiTheme": "vs-dark",
            "path": "./themes/dusk-nocturne.json"
      },
      {
        "label": "Dusk-Office Finance",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-finance.json"
      },
      {
        "label": "Dusk-Office Corporate",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-corporate.json"
      }
    ],
    "configurationDefaults": {
      "editor.minimap.enabled": true,
      "editor.minimap.showSlider": "always",
      "editor.semanticHighlighting.enabled": true,
      "editor.bracketPairColorization.enabled": true,
      "editor.guides.bracketPairs": "active",
      "editor.guides.bracketPairsHorizontal": "active",
      "editor.guides.highlightActiveIndentation": true,
      "editor.stickyScroll.enabled": true,
      "editor.renderLineHighlight": "line",
      "editor.selectionHighlight": true,
      "editor.linkedEditing": true,
      "workbench.tree.renderIndentGuides": "always",
      "workbench.tree.indent": 14,
      "explorer.decorations.badges": true,
      "explorer.decorations.colors": true
    }
  },
  "scripts": {
    "sync": "node scripts/sync-from-workspace.mjs",
    "variants:ui": "node scripts/merge-extended-ui-colors.mjs",
    "soften:borders": "node scripts/soften-chrome-borders.mjs",
    "boost:borders": "node scripts/boost-border-contrast.mjs",
    "dim:borders": "node scripts/dim-border-luminosity.mjs",
    "variants:syntax": "node scripts/merge-syntax-into-variants.mjs",
    "validate": "node scripts/validate-themes.mjs",
    "release-check": "node scripts/verify-release-version.mjs",
    "build:light": "node scripts/build-dusk-light.mjs",
    "build:ivoire": "node scripts/build-dusk-ivoire.mjs",
    "build:ivoire-sombre": "node scripts/build-dusk-ivoire-sombre.mjs",
    "package": "npx --no-install @vscode/vsce package --no-dependencies",
    "install-vsix": "node scripts/install-vsix.mjs",
    "upgrade": "npm run package && node scripts/install-vsix.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  }
}
