{
  "name": "dusk-office",
  "displayName": "Dusk Office",
  "description": "Dark themes for VS Code and Cursor.",
  "version": "0.7.58",
  "publisher": "dekidev",
  "icon": "images/icon.png",
  "main": "./extension.js",
  "license": "UNLICENSED",
  "homepage": "https://marketplace.visualstudio.com/items?itemName=dekidev.dusk-office",
  "repository": {
    "type": "git",
    "url": "https://github.com/SIDIKICONDE/dusk-office.git"
  },
  "galleryBanner": {
    "color": "#031c28",
    "theme": "dark"
  },
  "qna": "marketplace",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "extensionPack": [
    "PKief.material-icon-theme"
  ],
  "keywords": [
    "theme",
    "dark",
    "cyan",
    "dusk-office",
    "contrast",
    "high contrast",
    "light",
    "semantic highlighting",
    "color-theme",
    "product-icon-theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Dusk Office",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk.json"
      },
      {
        "label": "Dusk Office Abyss",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-abime.json"
      },
      {
        "label": "Dusk Office Dawn",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-aube.json"
      },
      {
        "label": "Dusk Office Bay",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-baie.json"
      },
      {
        "label": "Dusk Office Mist",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-brume.json"
      },
      {
        "label": "Dusk Office Ash",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-cendre.json"
      },
      {
        "label": "Dusk Office Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-minuit.json"
      },
      {
        "label": "Dusk Office Nebula",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-nebuleuse.json"
      },
      {
        "label": "Dusk Office Reef",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-recif.json"
      },
      {
        "label": "Dusk Office High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/dusk-hc.json"
      },
      {
        "label": "Dusk Office Light",
        "uiTheme": "vs",
        "path": "./themes/dusk-light.json"
      },
      {
        "label": "Dusk Office Ivory",
        "uiTheme": "vs",
        "path": "./themes/dusk-ivoire.json"
      },
      {
        "label": "Dusk Office Dark Ivory",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-ivoire-sombre.json"
      },
      {
        "label": "Dusk Office Nocturne",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-nocturne.json"
      },
      {
        "label": "Dusk Office Finance",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-finance.json"
      },
      {
        "label": "Dusk Office Corporate",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-corporate.json"
      }
    ],
    "configurationDefaults": {
      "editor.minimap.enabled": true,
      "editor.minimap.showSlider": "always",
      "editor.semanticHighlighting.enabled": true,
      "editor.bracketPairColorization.enabled": true,
      "editor.guides.bracketPairs": "active",
      "editor.guides.bracketPairsHorizontal": "active",
      "editor.guides.highlightActiveIndentation": true,
      "editor.stickyScroll.enabled": true,
      "editor.renderLineHighlight": "line",
      "editor.selectionHighlight": true,
      "editor.linkedEditing": true,
      "workbench.tree.renderIndentGuides": "always",
      "workbench.tree.indent": 14,
      "explorer.decorations.badges": true,
      "explorer.decorations.colors": true
    },
    "configuration": {
      "title": "Dusk Office",
      "properties": {
        "duskOffice.applyFavoriteOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Apply the favorite theme on startup."
        },
        "duskOffice.rememberWorkspaceTheme": {
          "type": "boolean",
          "default": true,
          "description": "Remember the last Dusk Office theme for each workspace."
        },
        "duskOffice.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Dusk Office status bar button."
        },
        "duskOffice.autoSwitch.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Switch between light and dark Dusk Office themes by hour."
        },
        "duskOffice.autoSwitch.lightTheme": {
          "type": "string",
          "default": "Dusk Office Light",
          "enum": [
            "Dusk Office",
            "Dusk Office Abyss",
            "Dusk Office Dawn",
            "Dusk Office Bay",
            "Dusk Office Mist",
            "Dusk Office Ash",
            "Dusk Office Midnight",
            "Dusk Office Nebula",
            "Dusk Office Reef",
            "Dusk Office High Contrast",
            "Dusk Office Light",
            "Dusk Office Ivory",
            "Dusk Office Dark Ivory",
            "Dusk Office Nocturne",
            "Dusk Office Finance",
            "Dusk Office Corporate"
          ],
          "description": "Theme used during light hours."
        },
        "duskOffice.autoSwitch.darkTheme": {
          "type": "string",
          "default": "Dusk Office Midnight",
          "enum": [
            "Dusk Office",
            "Dusk Office Abyss",
            "Dusk Office Dawn",
            "Dusk Office Bay",
            "Dusk Office Mist",
            "Dusk Office Ash",
            "Dusk Office Midnight",
            "Dusk Office Nebula",
            "Dusk Office Reef",
            "Dusk Office High Contrast",
            "Dusk Office Light",
            "Dusk Office Ivory",
            "Dusk Office Dark Ivory",
            "Dusk Office Nocturne",
            "Dusk Office Finance",
            "Dusk Office Corporate"
          ],
          "description": "Theme used during dark hours."
        },
        "duskOffice.autoSwitch.lightHour": {
          "type": "integer",
          "default": 7,
          "minimum": 0,
          "maximum": 23,
          "description": "Hour to start the light theme."
        },
        "duskOffice.autoSwitch.darkHour": {
          "type": "integer",
          "default": 18,
          "minimum": 0,
          "maximum": 23,
          "description": "Hour to start the dark theme."
        }
      }
    },
    "commands": [
      {
        "command": "duskOffice.openControlCenter",
        "title": "Dusk Office: Control Center",
        "category": "Dusk Office"
      },
      {
        "command": "duskOffice.switchThemeVariant",
        "title": "Dusk Office: Choose Theme",
        "category": "Dusk Office"
      },
      {
        "command": "duskOffice.switchToPreviousTheme",
        "title": "Dusk Office: Previous Theme",
        "category": "Dusk Office"
      },
      {
        "command": "duskOffice.setFavoriteTheme",
        "title": "Dusk Office: Set Favorite",
        "category": "Dusk Office"
      },
      {
        "command": "duskOffice.switchToFavoriteTheme",
        "title": "Dusk Office: Favorite Theme",
        "category": "Dusk Office"
      },
      {
        "command": "duskOffice.toggleActivityBarLocation",
        "title": "Dusk Office: Toggle Activity Bar Position",
        "category": "Dusk Office"
      },
      {
        "command": "duskOffice.toggleAutoSwitch",
        "title": "Dusk Office: Toggle Auto Switch",
        "category": "Dusk Office"
      },
      {
        "command": "duskOffice.openSettings",
        "title": "Dusk Office: Settings",
        "category": "Dusk Office"
      }
    ]
  },
  "scripts": {
    "sync": "node scripts/sync-from-workspace.mjs",
    "sync:aa": "node scripts/sync-from-workspace.mjs",
    "sync:aaa": "node -e \"process.env.SYNC_MIN_CONTRAST='7'; import('./scripts/sync-from-workspace.mjs')\"",
    "make:full": "npm run sync:aa && npm run variants:ui && npm run variants:syntax && npm run build:light && npm run build:ivoire && npm run build:ivoire-sombre && npm run validate",
    "make:full:install": "npm run make:full && npm run package && npm run install-vsix",
    "make:release": "npm run make:full && npm run package && node scripts/clean-old-vsix.mjs",
    "make:release:no-bump": "npm run make:full && npm run package:raw && node scripts/clean-old-vsix.mjs",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major",
    "release:patch": "npm run make:release",
    "release:minor": "npm run bump:minor && npm run make:release:no-bump",
    "release:major": "npm run bump:major && npm run make:release:no-bump",
    "release:patch:install": "npm run release:patch && npm run install-vsix",
    "release:minor:install": "npm run release:minor && npm run install-vsix",
    "release:major:install": "npm run release:major && npm run install-vsix",
    "full": "npm run make:full",
    "rel": "npm run make:release",
    "rpi": "npm run release:patch:install",
    "push:auto": "npm run push:main:auto",
    "push:safe": "npm run push:main:safe",
    "push:main:auto": "node scripts/auto-push-main.mjs --yes",
    "push:main:safe": "node scripts/auto-push-main.mjs --safe",
    "variants:ui": "node scripts/merge-extended-ui-colors.mjs",
    "soften:borders": "node scripts/soften-chrome-borders.mjs",
    "boost:borders": "node scripts/boost-border-contrast.mjs",
    "dim:borders": "node scripts/dim-border-luminosity.mjs",
    "variants:syntax": "node scripts/merge-syntax-into-variants.mjs",
    "validate": "node scripts/validate-themes.mjs",
    "release-check": "node scripts/verify-release-version.mjs",
    "build:light": "node scripts/build-dusk-light.mjs",
    "build:ivoire": "node scripts/build-dusk-ivoire.mjs",
    "build:ivoire-sombre": "node scripts/build-dusk-ivoire-sombre.mjs",
    "prepackage": "node scripts/bump-version.mjs patch",
    "package": "npm run package:raw",
    "package:raw": "npx --no-install @vscode/vsce package --no-dependencies",
    "install-vsix": "node scripts/install-vsix.mjs",
    "upgrade": "npm run package && node scripts/install-vsix.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.1",
    "@types/react": "^19.2.14",
    "@vscode/vsce": "^3.2.2",
    "typescript": "~5.7.3"
  }
}
