# Copiez en .env.local et remplissez vos tokens (fichier gitignored).
# GitHub Actions : mêmes noms en secrets repo (Settings → Secrets → Actions).

# Visual Studio Marketplace — PAT Azure DevOps (scope Marketplace → Manage)
VSCE_PAT=

# Open VSX — https://open-vsx.org/user-settings/tokens
OVSX_PAT=

# JetBrains Marketplace — permanent token (publisher SIDIKICONDE)
JETBRAINS_TOKEN=

# Optionnel — identité git pour make release / push-main-auto (sans git config --global)
# GIT_AUTHOR_NAME=SIDIKICONDE
# GIT_AUTHOR_EMAIL=SIDIKICONDE@users.noreply.github.com
